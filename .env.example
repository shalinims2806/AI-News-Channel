# ---------- Database ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ainews?schema=public"

# ---------- Site ----------
SITE_NAME="AI News Channel"          # replace with your channel name
SITE_URL="http://localhost:3000"     # public base URL (used for canonical links, sitemap, Telegram links)
SITE_TAGLINE="Latest news, summarized by AI. Always linked to the original source."
CONTACT_EMAIL="contact@example.com"

# ---------- Social links (single source of truth; no URLs are hard-coded elsewhere) ----------
INSTAGRAM_URL=""
FACEBOOK_URL=""
TELEGRAM_URL=""                      # public invite link, e.g. https://t.me/yourchannel

# ---------- Auth ----------
AUTH_SECRET=""                       # >= 32 chars: `openssl rand -base64 48`
ADMIN_EMAIL="admin@example.com"      # used by `npm run db:seed` to create the first admin
ADMIN_PASSWORD=""                    # >= 12 chars; only read by the seed script

# ---------- Scheduled jobs ----------
CRON_SECRET="e8903eec75bd14deea252b4cb0804856f2c613a8cfd36b5fe88ead83ba15dfaa"                       # Vercel sends this as "Authorization: Bearer <secret>" to /api/cron/ingest
INGEST_INTERVAL_CRON="*/10 * * * *"  # only for the long-running worker (npm run worker)
MAX_ARTICLE_AGE_HOURS="72"           # ignore feed items older than this
MAX_AI_PER_RUN="30"                  # cap AI calls per ingestion run (cost / time control)
BREAKING_MIN_SOURCES="3"             # independent outlets needed before auto-flagging a story as breaking
BREAKING_WINDOW_HOURS="3"

# ---------- AI provider (server-side only) ----------
AI_PROVIDER="heuristic"              # heuristic | openai | anthropic  (heuristic = no LLM, extractive; works without a key)
AI_API_KEY=""
AI_MODEL=""                          # default: gpt-4o-mini (openai) / claude-haiku-4-5-20251001 (anthropic)
AI_BASE_URL=""                       # optional: any OpenAI-compatible endpoint (Azure, OpenRouter, Ollama...)
AI_TIMEOUT_MS="30000"

# ---------- News APIs (optional, additional to RSS sources) ----------
NEWS_API_KEY=""                      # reserved for the NewsAPI-style adapter in services/ingestion/adapters

# ---------- Telegram (optional) ----------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""                  # @channelusername or numeric chat id; the bot must be a channel admin
MAX_NEW_PER_RUN="40"                 # cap new stories processed per run (keeps runs short; the rest is picked up next run)
